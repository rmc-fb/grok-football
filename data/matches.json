async function loadMatches() {
  try {
    const res = await fetch('data/matches.json?t=' + Date.now()); // キャッシュ回避
    const data = await res.json();
    
    const container = document.getElementById('schedule-list');
    container.innerHTML = '';

    data.forEach(item => {
      // 実際のJSON構造に合わせてキー名を調整
      const home = item.homeTeam?.name || item.home?.name || '???';
      const away = item.awayTeam?.name || item.away?.name || '???';
      const time = item.startTime || item.time || '';
      const league = item.league?.name || item.tournament?.name || '';
      
      const hasJapanese = (item.players || []).some(p => 
        p.nationality === 'Japan' || p.name.includes('伊藤') || /* 他の日本人選手名 */
      );

      const cardHTML = `
        <div class="match-card ${hasJapanese ? 'highlight' : ''}">
          <div class="date">${new Date(time).toLocaleDateString('ja-JP')}</div>
          <div class="league">${league}</div>
          <div class="teams">
            <span>${home}</span> vs <span>${away}</span>
          </div>
          <div class="time">${time}</div>
          ${hasJapanese ? '<span class="japanese-player">🇯🇵 日本人選手</span>' : ''}
        </div>
      `;
      container.innerHTML += cardHTML;
    });
  } catch (err) {
    console.error("データ読み込み失敗", err);
  }
}

// ページロード時に実行
window.onload = loadMatches;